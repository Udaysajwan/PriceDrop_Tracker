# Environment Configuration
PROJECT_NAME="Price Drop Tracker & Alert API"
DEBUG=True

# Database Backend: "firestore" (Firebase Cloud Firestore) or "sqlite"
DATABASE_BACKEND="firestore"
FIREBASE_CREDENTIALS_PATH="firebase-credentials.json"
FIREBASE_PROJECT_ID=""

# Fallback SQL Database URL (used if DATABASE_BACKEND="sqlite" or "postgres")
DATABASE_URL="sqlite:///./price_tracker.db"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/price_tracker"

# Security & JWT
SECRET_KEY="replace-with-a-very-secure-random-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Scheduler Settings
DEFAULT_SCRAPE_INTERVAL_MINUTES=60
SCHEDULER_ENABLED=True

# Notification Settings (Optional SMTP)
SMTP_ENABLED=False
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
ALERT_FROM_EMAIL="alerts@pricetracker.local"
